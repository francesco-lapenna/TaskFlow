{
  "name": "@taskflow/backend",
  "version": "0.1.0",
  "description": "TaskFlow LoopBack 4 API",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "lb-tsc",
    "clean": "lb-clean dist *.tsbuildinfo",
    "rebuild": "npm run clean && npm run build",
    "start": "node -r source-map-support/register dist/index.js",
    "dev": "tsc-watch --target es2020 --outDir ./dist --onSuccess \"node -r source-map-support/register dist/index.js\"",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate": "node -r source-map-support/register dist/migrate.js"
  },
  "dependencies": {
    "@loopback/boot": "^7.0.0",
    "@loopback/core": "^6.0.0",
    "@loopback/repository": "^7.0.0",
    "@loopback/rest": "^14.0.0",
    "@loopback/rest-explorer": "^7.0.0",
    "@loopback/service-proxy": "^7.0.0",
    "loopback-connector-mysql": "^7.0.0",
    "loopback-datasource-juggler": "^5.1.0",
    "source-map-support": "^0.5.21",
    "tslib": "^2.6.3"
  },
  "devDependencies": {
    "@loopback/build": "^11.0.0",
    "@loopback/eslint-config": "^15.0.0",
    "@types/node": "^20.14.10",
    "eslint": "^8.57.0",
    "prettier": "^3.3.2",
    "tsc-watch": "^6.2.0",
    "typescript": "^5.4.5"
  }
}
