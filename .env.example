# Shared compose-level defaults. Copy to .env before running `docker compose up`.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=taskflow
MYSQL_PORT=3306

# --- Backend ---
BACKEND_PORT=3000
# in-memory by default; flip to "mysql" once you want persistence
DB_CONNECTOR=memory

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000
